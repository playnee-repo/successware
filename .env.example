# =============================================================================
# SDLC Copilot - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
#   Windows: copy .env.example .env.local
#   Linux/Mac: cp .env.example .env.local
#
# NUNCA commite .env.local - ele está no .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obrigatório)
# -----------------------------------------------------------------------------
# Para DESENVOLVIMENTO LOCAL: use as credenciais do Supabase local (após supabase start)
# Para PRODUÇÃO: use as credenciais do seu projeto no Supabase Dashboard
#
# Local:  https://supabase.com/docs/guides/cli/local-development
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<mostrado após "supabase start">
#
# Produção: Settings > API no Supabase Dashboard
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon public key>
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: Service Role Key (apenas para scripts/admin, NUNCA exponha no frontend)
# Usado para criar usuários via API, bypass RLS, etc.
# VITE_SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# IA — Provedor (opcional, default: openai)
# -----------------------------------------------------------------------------
# VITE_AI_PROVIDER=openai          # "openai" (default) ou "gemini"
#
# OpenAI (default):
# VITE_OPENAI_API_KEY=
#
# Gemini (alternativo):
# VITE_GEMINI_API_KEY=
